APP_NAME="Fleet Energy Analytics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 ou MariaDB 10.6+ (requêtes et migrations propres à MySQL/MariaDB).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fleet_energy
DB_USERNAME=root
DB_PASSWORD=
# Facultatif : dossier contenant mysqldump, s'il n'est pas dans le PATH (requis par backup:run).
DB_DUMP_BINARY_PATH=

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# « reverb » seulement si le POC temps réel est lancé (php artisan reverb:start) ; sinon « log ».
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Aucune table jobs/cache n'est migrée dans ce projet : file synchrone et cache fichier.
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ne servent qu'à amorcer UN compte Admin pendant « php artisan migrate ». Inutile pour la
# démonstration : « php artisan migrate --seed » crée les comptes demo/demo et consultant/consultant.
ACCES_IDENTIFIANT=
ACCES_MOT_DE_PASSE=

# ===== Intégrations externes — TOUTES FACULTATIVES =====
# La démonstration fonctionne entièrement sans elles, sur les données fictives du seeder.

# Registre tableur : ID du classeur + clé JSON d'un compte de service en lecture seule.
GOOGLE_SERVICE_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON_LOCATION=storage/app/google-service-account.json
GOOGLE_SHEETS_REGISTRE_ID=

# Météo (OpenWeatherMap). Sans clé, aucun appel réseau : la météo s'affiche comme indisponible.
OPENWEATHERMAP_API_KEY=

# ===== Temps réel (Laravel Reverb), facultatif =====
# REVERB_SERVER_PORT (écoute du serveur) et REVERB_PORT (connexion du navigateur) doivent être égaux.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SERVER_PORT=6001
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
